{
  "name": "taskmaster-plugin",
  "version": "0.4.1",
  "description": "Local-first task and meeting management with React Kanban inside Obsidian.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build:css && node esbuild.config.mjs",
    "build": "npm run build:css && node esbuild.config.mjs --prod",
    "build:css": "postcss src/styles/tailwind.css -o src/styles/built.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "kanban"
  ],
  "author": "TaskMaster Team",
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ulid": "^2.3.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.31.0",
    "jsdom": "^25.0.1",
    "obsidian": "^1.7.2",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
